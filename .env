# ============================================================
#  DialogueAPI - configuração (uso pessoal)
# ============================================================
# Endereço do PLUGIN (servidor Minecraft) + porta do web-editor (config.yml do plugin -> web-editor.port).
# Na Square Cloud NÃO use localhost: coloque o IP/domínio do host do Minecraft. Ex.: http://123.45.67.89:8166
PLUGIN_URL=http://localhost:8166

# Token fixo do plugin (config.yml -> web-editor.api-token). Serve para entrar no editor sem o link
# do /ned web-editor: cole ele na tela de entrada do site. O servidor web NÃO usa este valor.
API_TOKEN=01d97db6b2ee84bd13a35c82eefb0a81124ff5ed48c169b8

# HOST e PORT: não defina na Square Cloud (ela usa 0.0.0.0 e 80). No PC, o padrão é a porta 5173.
